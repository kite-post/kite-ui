{
  "$description": "Семантичні токени (стайлгайд, розділ 3.2). Посилання {група.крок} ведуть на primitives.json; значення з альфою — rgb(... / a). Перемикаються з темою.",
  "color": {
    "bg": { "light": "{paper}", "dark": "{slate.975}" },
    "bg-subtle": { "light": "{slate.100}", "dark": "{slate.900}" },
    "surface": { "light": "{white}", "dark": "{slate.900}" },
    "surface-raised": { "light": "{white}", "dark": "#1E2C40" },
    "surface-sunken": { "light": "{slate.50}", "dark": "{slate.975}" },
    "surface-hover": { "light": "{slate.100}", "dark": "{slate.800}" },
    "surface-active": { "light": "{slate.200}", "dark": "{slate.700}" },
    "surface-inverse": { "light": "{slate.950}", "dark": "{snow}" },
    "scrim": { "light": "rgb(14 26 43 / 0.5)", "dark": "rgb(0 0 0 / 0.6)" },
    "raised-border": { "light": "transparent", "dark": "{slate.800}" },

    "text": { "light": "{slate.950}", "dark": "{snow}" },
    "text-muted": { "light": "{slate.600}", "dark": "{slate.400}" },
    "text-disabled": { "light": "{slate.400}", "dark": "{slate.600}" },
    "text-inverse": { "light": "{snow}", "dark": "{slate.950}" },
    "text-link": { "light": "{sky.700}", "dark": "{sky.400}" },
    "text-link-hover": { "light": "{sky.800}", "dark": "{sky.300}" },

    "border": { "light": "{slate.200}", "dark": "{slate.800}" },
    "border-strong": { "light": "{slate.300}", "dark": "{slate.700}" },
    "border-input": { "light": "{slate.500}", "dark": "{slate.500}" },
    "border-input-hover": { "light": "{slate.600}", "dark": "{slate.400}" },
    "border-focus": { "light": "{sky.600}", "dark": "{sky.400}" },

    "primary": { "light": "{coral.500}", "dark": "{coral.500}" },
    "primary-hover": { "light": "{coral.400}", "dark": "{coral.400}" },
    "primary-active": { "light": "{coral.300}", "dark": "{coral.300}" },
    "on-primary": { "light": "{slate.950}", "dark": "{slate.975}" },
    "primary-subtle": { "light": "{coral.50}", "dark": "{coral.950}" },
    "primary-text": { "light": "{coral.800}", "dark": "{coral.300}" },

    "neutral-solid": { "light": "{slate.700}", "dark": "{slate.300}" },
