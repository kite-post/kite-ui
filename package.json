{
  "name": "@kite-post/ui",
  "version": "0.7.0",
  "description": "UI-кіт Kite: дизайн-токени і Vue-компоненти",
  "keywords": [
    "vue",
    "ui-kit",
    "design-system",
    "tailwindcss",
    "kite"
  ],
  "homepage": "https://kite-post.github.io/kite-ui/",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/kite-post/kite-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "tokens/dart"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens.js"
    },
    "./style.css": "./dist/kite-ui.css",
    "./theme.css": "./dist/theme.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.ts",
    "tokens:check": "node scripts/build-tokens.ts --check",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "type-check": "vue-tsc --build",
    "lint": "eslint . && prettier --check src/",
    "lint:fix": "eslint . --fix && prettier --write src/",
    "test:unit": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@tanstack/vue-table": "8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "2.11.0",
    "tailwind-merge": "^3.7.1"
  },
  "peerDependencies": {
    "@lucide/vue": "^1.77.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@lucide/vue": "^1.77.0",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/vue3-vite": "^10.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@tsconfig/node26": "^26.0.2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.8",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.21.0"
}
